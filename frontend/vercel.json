{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www\\.(?<domain>.+)"
        }
      ],
      "destination": "https://$domain/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "/api/uploads?path=:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/thread/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Pinterest|LinkedInBot|TelegramBot|WhatsApp|vkShare|Slackbot|Discordbot).*"
        }
      ],
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
